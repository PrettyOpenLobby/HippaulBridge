# The FFXI title plugin, layered on the OpenLobby core image.
#
# The bridge is its own service (Dockerfile.bridge). This image is the core
# plus lsb/ffxititle.py, the part of FFXI that runs INSIDE the core's login
# and authsess processes: it serves each character's world identity and the
# profile tail out of the id map the bridge writes (the ffxi_idmap table in
# the core's own database). It carries ffxidb.py, which reads that table, and
# the migrations it comes from. docker-compose.title.yml swaps it in for those
# two services. Build the core first, or point OPENLOBBY_IMAGE at the image you
# use (a title image, to stack titles).
ARG OPENLOBBY_IMAGE=openlobby:latest
FROM ${OPENLOBBY_IMAGE}

COPY ffxidb.py /app/ffxidb.py
COPY ffxi_migrations /app/ffxi_migrations
COPY ffxititle.py /app/ffxititle.py

ENV POL_TITLES=ffxititle

# This image is the one that runs: login, authsess and discordbridge. The
# login process also serves the ISP-type mail ports, POP3 110 and SMTP 25
# (core/main.py, POL_POP3_PORT and POL_SMTP_PORT), and those are privileged,
# so it stays root like the core image. A first cut switched it to uid 1000
# and both binds failed with EACCES while every other listener came up.
USER root

# The bridge image. docker-compose.yml builds it from this directory and bakes
# the code in; nothing is bind-mounted over it at runtime, so what runs is what
# was built.
#
# It is built on the OpenLobby core image. The bridge reads the accounts
# through the core's accounts module and keeps its own two maps in the core's
# PostgreSQL through polcore (lsb/ffxidb.py), and the core image carries both
# and their database drivers. Build the core first, or point OPENLOBBY_IMAGE at
# the image you use. The Python base and its digest pin are the core's.
ARG OPENLOBBY_IMAGE=openlobby:latest
FROM ${OPENLOBBY_IMAGE}

# pymysql: the character-import endpoint (BRIDGE_HTTP_PORT) writes the LSB
# database (MariaDB) directly. Without it the endpoint refuses gracefully and
# everything else still runs.
RUN pip install --no-cache-dir pymysql

WORKDIR /app
COPY ffxi_bridge.py /app/ffxi_bridge.py
COPY ffxi_import_core.py /app/ffxi_import_core.py
# The bridge's tables: the database plumbing and CrystalBridge's migrations
# (6001-6999), applied by the bridge when it starts.
COPY ffxidb.py /app/ffxidb.py
COPY ffxi_migrations /app/ffxi_migrations
# Generated from LSB's own source (currency packet layouts, learned-ability
# ids, quest log structures, home points). WITHOUT THIS the endpoint still runs
# and still imports everything else -- it just says those pieces were skipped.
# That is deliberate, but it also means a forgotten COPY here is a data gap
# that only shows in the self-serve path, never in the admin import path.
COPY ffxi_lsb_tables.py /app/ffxi_lsb_tables.py

# Refuse to build on a base without the core's accounts module and polcore.
RUN python -c "import accounts, polcore.db, polcore.kv, ffxidb" \
    || (echo "the base image has no OpenLobby core (accounts, polcore); build it from the OpenLobby image" >&2; exit 1)

# Mutable state does NOT live in the image: the Content ID map and the account
# map are tables in the core's PostgreSQL (POL_DATABASE_URL). -u so
# `docker logs` sees output immediately; the bridge's own diagnostics are
# worthless an hour late.
ENTRYPOINT ["python", "-u", "ffxi_bridge.py"]
